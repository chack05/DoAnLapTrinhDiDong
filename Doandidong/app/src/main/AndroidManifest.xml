<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        File Manifest này được viết lại toàn bộ để sửa lỗi khai báo thiếu package cho các Activity,
        là nguyên nhân chính gây ra lỗi ActivityNotFoundException khi đăng nhập.
    -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Doandidong"
        tools:targetApi="31">

        <!-- Màn hình khởi chạy ứng dụng -->
        <activity
            android:name=".le_hong_son.ManHinhDangNhap"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Khai báo đầy đủ các Activity với package tương ứng -->
        <activity android:name=".le_hong_son.ManHinhDangKy" />
        <activity android:name=".main.ManHinhChinh" android:exported="true" />
        <activity android:name=".main.ManHinhDashboard" />
        <activity android:name=".mainUser.ManHinhTrangChuUser" android:exported="true" />
        <activity android:name=".mainUser.ManHinhLichSuMuaHang" />

        <activity android:name=".do_duc_anh.ManHinhDanhSachKhach" />
        <activity android:name=".do_duc_anh.ManHinhThemKhach" />
