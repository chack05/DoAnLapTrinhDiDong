        <activity android:name=".nguyen_van_dai.ManHinhSanPham" />
        <activity android:name=".nguyen_van_dai.ManHinhThemSanPham" />
        <activity android:name=".nguyen_van_dai.ManHinhSuaSanPham" />
        <activity android:name=".nguyen_van_dai.ManHinhChiTietSanPham" />

        <activity android:name=".phan_thanh_tai.ManHinhQuanLyDonHang" />
        <activity android:name=".phan_thanh_tai.ManHinhTaoDonHang" />
        <activity android:name=".phan_thanh_tai.ManHinhSuaDon" />
        <activity android:name=".phan_thanh_tai.ManHinhChiTietDon" />

        <activity android:name=".le_hong_son.ManHinhDanhSachDanhMuc" />
