<?xml version="1.0" encoding="utf-8"?>
<!-- File: item_background_selector.xml -->
<!-- Selector để thay đổi drawable dựa trên trạng thái của View -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Khi View ở trạng thái được nhấn (pressed) -->
    <item android:state_pressed="true"
        android:drawable="@drawable/item_background_pressed" />
    <!-- Trạng thái mặc định (không được nhấn) -->
    <item android:drawable="@drawable/item_background_normal" />
</selector>
