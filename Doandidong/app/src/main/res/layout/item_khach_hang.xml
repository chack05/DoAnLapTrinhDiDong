<?xml version="1.0" encoding="utf-8"?>
<!-- File: item_khach_hang.xml -->
<!-- Sử dụng LinearLayout làm gốc cho toàn bộ item -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@drawable/item_background_selector"
    android:gravity="center_vertical">

    <!-- CardView để tạo avatar hình tròn -->
    <androidx.cardview.widget.CardView
        android:layout_width="64dp"
        android:layout_height="64dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="2dp">
        <!-- ImageView chứa hình ảnh avatar (ảnh mặc định) -->
        <ImageView
            android:id="@+id/ivAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@mipmap/ic_launcher_round"
            android:scaleType="centerCrop"/>
    </androidx.cardview.widget.CardView>

    <!-- LinearLayout dọc chứa thông tin khách hàng (Tên, Mã, SĐT, Email) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <!-- TextView hiển thị tên khách hàng -->
        <TextView
            android:id="@+id/tvTenKhachHang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên Khách Hàng"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"/>

        <!-- TextView hiển thị mã khách hàng -->
        <TextView
            android:id="@+id/tvMaKhachHang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mã: KH001"
            android:textSize="14sp"
            android:layout_marginTop="2dp"/>

        <!-- TextView hiển thị số điện thoại -->
        <TextView
            android:id="@+id/tvSoDienThoai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SĐT: 0123456789"
            android:textSize="14sp"
            android:layout_marginTop="2dp"/>
            
        <!-- TextView hiển thị email -->
        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email: test@gmail.com"
            android:textSize="14sp"
            android:layout_marginTop="2dp"/>

    </LinearLayout>

    <!-- LinearLayout chứa 2 nút Sửa và Xóa -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Button Chỉnh sửa -->
        <Button
            android:id="@+id/btnSua"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Sửa"
            android:backgroundTint="#FFA000"
            android:textColor="@android:color/white"/>

        <!-- Button Xóa -->
        <Button
            android:id="@+id/btnXoa"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Xóa"
            android:layout_marginTop="8dp"
            android:backgroundTint="#D32F2F"
            android:textColor="@android:color/white"/>

    </LinearLayout>

</LinearLayout>