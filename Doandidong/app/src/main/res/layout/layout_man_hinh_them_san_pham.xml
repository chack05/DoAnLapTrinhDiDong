<?xml version="1.0" encoding="utf-8"?>
<!-- File: layout_man_hinh_them_san_pham.xml -->
<!-- Mô tả: Bố cục được refactor cho màn hình Thêm sản phẩm, với Toolbar tùy chỉnh. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F8">

    <!-- Toolbar tùy chỉnh, thay thế cho header cũ -->
    <include android:id="@+id/layoutHeader" layout="@layout/layout_toolbar_con"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Vùng hiển thị và chọn ảnh -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hình ảnh sản phẩm"
                android:textStyle="bold"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                android:layout_marginTop="8dp">
                <ImageView
                    android:id="@+id/ivHinhAnhSanPham"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="#E0E0E0"
                    android:src="@android:drawable/ic_menu_gallery"/>
            </androidx.cardview.widget.CardView>

            <!-- Form nhập liệu -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên sản phẩm"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>
            <EditText
                android:id="@+id/edtTenSanPham"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nhập tên sản phẩm"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mã sản phẩm"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>
            <EditText
                android:id="@+id/edtMaSanPham"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ví dụ: SP001"/>

            <!-- Layout ngang cho Đơn vị tính và Giá bán -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">
                <!-- Spinner Đơn vị tính -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đơn vị tính"
                        android:textStyle="bold"/>
                    <Spinner
                        android:id="@+id/spinnerDonViTinh"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"/>
                </LinearLayout>
                <!-- EditText Giá bán -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Giá bán (VND)"
                        android:textStyle="bold"/>
                    <EditText
                        android:id="@+id/edtGiaBan"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="50000"
                        android:inputType="numberDecimal"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Danh mục"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>
            <Spinner
                android:id="@+id/spinnerDanhMuc"
                android:layout_width="match_parent"
                android:layout_height="48dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mô tả sản phẩm"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>
            <EditText
                android:id="@+id/edtMoTa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="100dp"

                android:hint="Nhập mô tả chi tiết..."
                android:gravity="top"/>

            <!-- Nút Lưu chiếm toàn bộ chiều rộng -->
            <Button
                android:id="@+id/btnLuu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lưu"
                android:backgroundTint="?attr/colorPrimary"
                android:textColor="@android:color/white"
                android:layout_marginTop="32dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>