<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Bên trái: Ngày tháng -->
        <TextView
            android:id="@+id/tvNgayThangLichSu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="dd/MM"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginEnd="8dp"/>

        <!-- Ở giữa: Tên khách hàng và Mã đơn hàng -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvTenKhachHangLichSu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên khách hàng"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:maxLines="1"
                android:ellipsize="end"/>
            <TextView
                android:id="@+id/tvMaDonHangLichSu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#DH12345"
                android:textSize="12sp"
                android:textColor="#AAAAAA"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <!-- Bên phải: Tổng tiền và nút Xóa -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tvTongTienLichSu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.250.000 VNĐ"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#4CAF50"
                android:layout_marginEnd="8dp"/>

            <ImageButton
                android:id="@+id/btnXoaLichSu"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_delete"
                android:background="@android:color/transparent"
                android:tint="#F44336"
                android:contentDescription="Ẩn đơn hàng khỏi lịch sử"
                android:scaleType="fitCenter"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Divider (đường kẻ ngăn cách) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        android:layout_marginTop="8dp"/>

</LinearLayout>
