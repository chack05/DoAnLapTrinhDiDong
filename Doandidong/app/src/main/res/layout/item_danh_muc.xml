<?xml version="1.0" encoding="utf-8"?>
<!-- File: item_danh_muc.xml -->
<!-- Mô tả: Layout cho một hàng trong RecyclerView của danh sách danh mục. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground">

    <!-- Tên danh mục -->
    <TextView
        android:id="@+id/tvCategoryName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Tên Danh mục"
        android:textSize="16sp"
        android:textColor="@android:color/black"/>

    <!-- Nút Sửa -->
    <ImageButton
        android:id="@+id/btnEditCategory"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_edit"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Sửa danh mục"/>

    <!-- Nút Xóa -->
    <ImageButton
        android:id="@+id/btnDeleteCategory"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_delete"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Xóa danh mục"/>

</LinearLayout>
