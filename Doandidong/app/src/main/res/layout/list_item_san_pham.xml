<?xml version="1.0" encoding="utf-8"?>
<!-- Sử dụng LinearLayout làm layout gốc cho một item sản phẩm -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical"
    android:background="@android:color/white">

    <!-- LinearLayout chứa thông tin tên và số lượng -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- TextView để hiển thị tên sản phẩm -->
        <TextView
            android:id="@+id/tvTenSanPham"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên Sản Phẩm"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"/>

        <!-- TextView để hiển thị số lượng tồn kho -->
        <TextView
            android:id="@+id/tvSoLuongTon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tồn kho: 100"
            android:textSize="14sp"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- TextView để hiển thị giá bán sản phẩm -->
    <TextView
        android:id="@+id/tvGiaBan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="500,000 VND"
        android:textSize="16sp"
        android:textColor="#00897B"
        android:textStyle="bold"/>

</LinearLayout>
