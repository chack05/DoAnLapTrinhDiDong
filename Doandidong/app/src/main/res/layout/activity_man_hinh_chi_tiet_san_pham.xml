<?xml version="1.0" encoding="utf-8"?>
<!-- File: activity_man_hinh_chi_tiet_san_pham.xml -->
<!-- Mô tả: Bố cục được refactor cho màn hình chi tiết sản phẩm, với Toolbar tùy chỉnh. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Toolbar tùy chỉnh, thay thế cho header cũ -->
    <include android:id="@+id/layoutHeader" layout="@layout/layout_toolbar_con"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Ảnh sản phẩm -->
            <ImageView
                android:id="@+id/ivHinhAnhDetail"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:scaleType="centerCrop"
                android:background="#E0E0E0"/>

            <!-- Phần thông tin chi tiết -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Tên sản phẩm, lớn hơn -->
                <TextView
                    android:id="@+id/tvTenSanPhamDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tên Sản Phẩm"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="8dp"/>

                <!-- Giá sản phẩm -->
                <TextView
                    android:id="@+id/tvGiaDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="50,000 VND"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#D32F2F"
                    android:layout_marginBottom="16dp"/>

                <!-- Mã sản phẩm, Đơn vị, Danh mục -->
                <TextView
                    android:id="@+id/tvMaSanPhamDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mã sản phẩm: SP001"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:id="@+id/tvDonViDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đơn vị: Cái"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:id="@+id/tvDanhMucDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Danh mục: Đồ ăn"
                    android:textSize="16sp"
                    android:layout_marginBottom="16dp"/>

                <!-- Dấu gạch ngang phân cách -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="16dp"/>

                <!-- Mô tả sản phẩm -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mô tả"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:id="@+id/tvMoTaDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Đây là mô tả chi tiết về sản phẩm..."
                    android:textSize="16sp"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>

            <!-- Nút bấm Sửa và Xóa -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnXoaSanPham"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Xóa sản phẩm"
                    android:backgroundTint="#D32F2F"
                    android:textColor="@android:color/white"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnSuaSanPham"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sửa sản phẩm"
                    android:backgroundTint="#0288D1"
                    android:textColor="@android:color/white"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Khu vực bình luận -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#F8F8F8">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bình luận"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/edtCommentContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Viết bình luận của bạn..."
                    android:minHeight="48dp"
                    android:padding="10dp"
                    android:background="@drawable/custom_input"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btnSubmitComment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="GỬI BÌNH LUẬN"
                    android:backgroundTint="#4CAF50"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Các bình luận khác"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#555555"
                    android:layout_marginBottom="8dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvComments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>