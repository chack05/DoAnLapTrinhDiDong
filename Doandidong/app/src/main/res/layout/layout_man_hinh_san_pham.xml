<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar tùy chỉnh có thể tái sử dụng -->
        <include android:id="@+id/layoutHeader" layout="@layout/layout_toolbar_con" />

        <!-- Ô tìm kiếm sản phẩm -->
        <EditText
            android:id="@+id/edtTimKiemSP"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:hint="Tìm kiếm sản phẩm..."
            android:padding="10dp"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            android:background="@drawable/spinner_background"
            android:minHeight="48dp" />

        <!-- Spinner lọc theo danh mục -->
        <Spinner
            android:id="@+id/spinnerDanhMucLoc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/spinner_background"
            android:minHeight="48dp" />

        <!-- Phần sub-header hiển thị tổng số lượng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp"
            android:background="@android:color/white"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Danh sách sản phẩm\nNHÓM 4 / NGUYEN VAN DAI"
                android:textColor="#3F51B5"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvTongSoLuongSP"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tổng số lượng: 0"
                android:textSize="14sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- RecyclerView để hiển thị danh sách sản phẩm -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewSanPham"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp"
            android:clipToPadding="false"/>

    </LinearLayout>

    <!-- Nút hành động nổi (FAB) để thêm sản phẩm mới -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabThemSanPham"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:src="@android:drawable/ic_input_add"
        app:tint="@android:color/white"
        android:contentDescription="Thêm sản phẩm mới" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>