<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F4F8">

    <!-- Toolbar tùy chỉnh đã được đồng bộ -->
    <include
        android:id="@+id/layoutHeader"
        layout="@layout/layout_toolbar_con" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Khối thông tin chung đơn hàng -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvChiTietOrderId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mã đơn hàng: #ORD123"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvChiTietCustomerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Khách hàng: Tên Khách Hàng"
                        android:textSize="16sp"
                        android:textColor="#555555"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvChiTietOrderDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ngày đặt: 01/01/2023"
                        android:textSize="14sp"
                        android:textColor="#888888"
                        android:layout_marginBottom="8dp"/>

                    <!-- Trạng thái đơn hàng -->
                    <TextView
                        android:id="@+id/tvChiTietOrderStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trạng thái: Chờ xác nhận"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FF9800"
                        android:layout_marginBottom="16dp"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"/>
                    
                    <!-- Các nút cập nhật trạng thái (Chỉ admin) -->
                    <LinearLayout
                        android:id="@+id/layoutAdminActions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp"
                        android:weightSum="3"
                        android:visibility="gone"> <!-- Mặc định ẩn, chỉ admin mới thấy -->

                        <Button
                            android:id="@+id/btnDuyetDon"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="DUYỆT"
                            android:textSize="14sp"
                            android:backgroundTint="#007BFF"
                            android:textColor="@android:color/white"
                            android:layout_marginEnd="4dp"/>

                        <Button
                            android:id="@+id/btnHoanTatDon"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="HOÀN TẤT"
                            android:textSize="14sp"
                            android:backgroundTint="#28a745"
                            android:textColor="@android:color/white"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"/>

                        <Button
                            android:id="@+id/btnHuyDon"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="HỦY"
                            android:textSize="14sp"
                            android:backgroundTint="#F44336"
                            android:textColor="@android:color/white"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="end">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tổng tiền: "
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/black"
                            android:layout_marginEnd="8dp"/>
                        <TextView
                            android:id="@+id/tvChiTietTotalAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 VNĐ"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#D32F2F"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Khối chi tiết sản phẩm trong đơn hàng -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sản phẩm trong đơn"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_marginBottom="8dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvChiTietSanPhamTrongDon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:background="#FFFFFF"
                android:padding="8dp"
                android:layout_marginBottom="16dp"/>

            <!-- Nút Xóa, Sửa và In Hóa Đơn -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"> <!-- Sử dụng weightSum để phân chia 3 nút đều nhau -->

                <Button
                    android:id="@+id/btnXoaDon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="XÓA"
                    android:textSize="16sp"
                    android:backgroundTint="#F44336"
                    android:textColor="@android:color/white"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btnSuaDon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SỬA"
                    android:textSize="16sp"
                    android:backgroundTint="#007BFF"
                    android:textColor="@android:color/white"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btnInHoaDon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="IN PDF"
                    android:textSize="16sp"
                    android:backgroundTint="#28a745"
                    android:textColor="@android:color/white"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
