<?xml version="1.0" encoding="utf-8"?>
<!-- Layout cho một item trong danh sách chi tiết đơn hàng -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical"
    android:background="@android:color/white">

    <!-- LinearLayout chứa thông tin tên và giá đơn vị -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- TextView để hiển thị tên sản phẩm -->
        <TextView
            android:id="@+id/tvTenSanPhamChiTiet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên Sản Phẩm"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"/>

        <!-- TextView để hiển thị giá đơn vị x số lượng -->
        <TextView
            android:id="@+id/tvGiaVaSoLuong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100,000 VND x 2"
            android:textSize="14sp"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- TextView để hiển thị thành tiền của item này -->
    <TextView
        android:id="@+id/tvThanhTien"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="200,000 VND"
        android:textSize="16sp"
        android:textColor="#00897B"
        android:textStyle="bold"/>

</LinearLayout>
